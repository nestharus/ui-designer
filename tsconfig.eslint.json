{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./apps/web/*"],
      "@ui-designer/shared-types": ["./packages/shared-types/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "services/**/*.ts",
    "services/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "*.ts",
    "*.tsx"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/build/**", "**/.next/**"]
}
