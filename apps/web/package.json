{
  "name": "@ui-designer/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --cache",
    "lint:fix": "eslint . --ext .ts,.tsx --fix --cache",
    "type-check": "tsc --noEmit",
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:unit": "vitest run --config ./vitest.config.unit.ts",
    "test:unit:watch": "vitest --config ./vitest.config.unit.ts",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "test:integration:watch": "vitest --config ./vitest.config.integration.ts",
    "test:all": "vitest run --config ./vitest.config.ts",
    "test:coverage:unit": "vitest run --coverage --config ./vitest.config.unit.ts",
    "test:coverage:integration": "vitest run --coverage --config ./vitest.config.integration.ts",
    "test:coverage:all": "vitest run --coverage --config ./vitest.config.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.13.0",
    "@emotion/react": "^11.13.3",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.13.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@ui-designer/shared-types": "workspace:*",
    "@ui-designer/query": "workspace:*",
    "next": "^15.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^3.13.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^24.1.0"
  }
}
