{
  "name": "ui-designer",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.0",
  "engines": {
    "bun": "1.3.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint -- --cache-location .eslintcache && eslint scripts --ext .js --cache --config scripts/eslint.config.js",
    "lint:fix": "turbo run lint:fix && eslint scripts --ext .js --fix --cache --config scripts/eslint.config.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:watch": "turbo run test -- --watch",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:all": "turbo run test:all",
    "test:coverage": "bun run test:coverage:all",
    "test:coverage:unit": "turbo run test:coverage:unit",
    "test:coverage:integration": "turbo run test:coverage:integration",
    "test:coverage:all": "turbo run test:coverage:all",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install --with-deps",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "clean": "turbo run clean && rimraf .turbo .bun-cache",
    "setup": "bun run --filter @ui-designer/shared-types build",
    "prepare": "lefthook install",
    "codemod:expect-soft": "bunx jscodeshift -t scripts/codemods/expect-to-expect-soft.js 'apps/**/*.{test,spec}.{ts,tsx}' 'packages/**/*.{test,spec}.{ts,tsx}' 'apps/**/tests/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "http-status-codes": "^2.3.0"
  },
  "devDependencies": {
    "@awesome.me/kit-1c646130fa": "^1.0.4",
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint-community/eslint-utils": "^4.9.0",
    "@eslint/js": "^9.37.0",
    "@humanfs/core": "^0.19.1",
    "@humanfs/node": "^0.16.7",
    "@next/eslint-plugin-next": "^15.5.4",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "1.3.0",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "bun-types": "^1.3.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-xo": "^0.49.0",
    "eslint-config-xo-typescript": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-visitor-keys": "^4.2.1",
    "globals": "^16.4.0",
    "jscodeshift": "^17.3.0",
    "lefthook": "^1.13.6",
    "lint-staged": "^16.2.4",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rimraf": "^6.0.1",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "tailwindcss": "^4.1.14",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
