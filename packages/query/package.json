{
  "name": "@ui-designer/query",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --cache",
    "lint:fix": "eslint src --ext .ts,.tsx --fix --cache",
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:coverage": "vitest run --coverage --config ./vitest.config.ts",
    "test:unit": "vitest run --config ./vitest.config.ts",
    "test:coverage:unit": "vitest run --coverage --config ./vitest.config.ts",
    "test:all": "vitest run --config ./vitest.config.ts",
    "test:coverage:all": "vitest run --coverage --config ./vitest.config.ts"
  },
  "dependencies": {
    "@ui-designer/shared-types": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
